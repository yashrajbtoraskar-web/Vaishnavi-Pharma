{
  "version": 2,
  "builds": [
    { "src": "*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/", "dest": "/index.html" },
    { "src": "/medicines", "dest": "/medicines.html" },
    { "src": "/cart", "dest": "/cart.html" },
    { "src": "/contact", "dest": "/contact.html" },
    { "src": "/prescription", "dest": "/prescription.html" }
  ]
}
